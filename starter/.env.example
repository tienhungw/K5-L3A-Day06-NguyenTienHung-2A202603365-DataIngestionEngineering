# Copy to starter/.env. The pipeline uses a local embedding model and Chroma; no API key is needed.
# Where Hugging Face stores the model (~470 MB). Uncomment to use a drive with more free space;
# leave it commented to use the default cache (~/.cache/huggingface).
# HF_HOME=D:/hf_cache
TOKENIZERS_PARALLELISM=false
# After the model has been downloaded once, the runs can be made offline:
# HF_HUB_OFFLINE=1

# Only for the optional pgvector setup check (docker compose + scripts/check_setup.py).
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
